.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Project-specific
# Datasets are never versioned (they may contain private information): everything under
# data/ is ignored except the folder skeleton (.gitkeep). Keep every dataset inside data/,
# since data files elsewhere are no longer ignored (test fixtures, for instance).
data/**
!data/**/
!data/**/.gitkeep

# Generated outputs: ignored, but the empty folders stay in the repo.
reports/*
!reports/.gitkeep
logs/*
!logs/.gitkeep

# Notebooks
.ipynb_checkpoints/
*.ipynb_checkpoints

# Temporary files
*.tmp
*.bak
